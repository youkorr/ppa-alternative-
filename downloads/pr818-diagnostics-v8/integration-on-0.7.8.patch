+    CHECK(owner_suspends == 1 && yields == 0);
+    CHECK(immediate_deletes == 1 && queued_deletes == 0);
+    require_delete_api();
+    CHECK(lv_thread_delete(&thread) == LV_RESULT_INVALID);
+    CHECK(owner_suspends == 1 && target.reclaimed == 1);
+    require_delete_api();
