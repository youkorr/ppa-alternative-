+def add_caps(source: str, cmake: str) -> str:
+    """Use the actual production CMake stack-caps deletion hook verbatim."""
+    match = re.search(r'set\(_lv_thread_delete_hook \[\[(.*?)\]\]\)', cmake, re.S)
