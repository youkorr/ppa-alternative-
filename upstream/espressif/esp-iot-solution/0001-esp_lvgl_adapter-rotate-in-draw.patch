+static void sw_execute_on(const lv_draw_task_t * t, lv_layer_t * layer, const lv_area_t * area,
+                          const lv_area_t * clip)
+{
+    lv_draw_task_t copy = *t;
+    copy.next = NULL;
+    copy.target_layer = layer;
+    copy.area = *area;
